{
  "name": "gauravkr-dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal site for Gaurav Kumar. Static output, built from content files.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs 8000",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "preview": "node scripts/build.mjs && node scripts/preview.mjs dist 8000",
    "parity": "node scripts/parity.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "check": "npm run validate && npm run check:prose && npm run check:admin && npm run parity"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0",
    "markdown-it": "^15.0.3",
    "markdown-it-container": "^4.0.0",
    "sharp": "^0.35.5"
  }
}
